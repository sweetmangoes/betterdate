# Get a key at https://platform.openai.com/api-keys
# Paste the key exactly as shown (usually starts with sk-proj-). Do not add an extra sk- prefix.
OPENAI_API_KEY=

# Google Maps Platform — enable Places API (New) + Geocoding API
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# Canonical public site URL (no trailing slash). Used for metadata, sitemap, robots.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Product flavor for this deploy. Defaults to date (Better Date).
# Use friends for the Better Hang sibling (second Vercel project, same repo).
# NEXT_PUBLIC_PRODUCT=date
# NEXT_PUBLIC_PRODUCT=friends

# Optional accounts (saved preference profiles). Leave unset to keep the guest-only quiz.
# Create a project at https://supabase.com then run supabase/schema.sql in the SQL editor.
# Auth → URL configuration: add http://localhost:3000/auth/callback (and the production callback).
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed to save plans (/p/[id] links) and text signups. Supabase → Settings → API → service_role.
# Never expose this in the browser (no NEXT_PUBLIC_ prefix).
# SUPABASE_SERVICE_ROLE_KEY=

# Twilio (Better Date texting). Console → Account info. Phone number in E.164, e.g. +16135550142.
# Without these, phone signups are saved and /start shows "you're on the list" instead of sending a text.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
