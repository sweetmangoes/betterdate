{
  "name": "betterdate",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:friends": "NEXT_PUBLIC_PRODUCT=friends next dev",
    "dev:mobile": "npm run start --workspace=@betterdate/mobile",
    "build": "next build",
    "build:web": "next build",
    "build:friends": "NEXT_PUBLIC_PRODUCT=friends next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "npm run typecheck:shared",
    "typecheck:shared": "npm run typecheck --workspace=@betterdate/shared"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/app/globals.css",
    "tailwindFunctions": [
      "clsx"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.17",
    "@betterdate/shared": "*",
    "@tailwindplus/elements": "0.0.0-insiders.98ea4bc",
    "ai": "^7.0.34",
    "clsx": "^2.1.1",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5"
  },
  "overrides": {
    "react-native": "0.81.5"
  },
  "description": "AI date planner for intentional first dates and couples"
}
